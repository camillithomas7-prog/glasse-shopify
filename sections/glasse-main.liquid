{%- comment -%}
  Product page: the main product renders the full glassé landing;
  any other product (spot dots, extra-jar offer) gets a simple branded page.
{%- endcomment -%}
{%- if product.handle == settings.main_product or template.suffix == 'glasse' -%}
  {% render 'glasse-landing' %}
{%- else -%}
  <div class="wrap dp-page" style="max-width:1000px">
    <div class="dp-prod">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="900" height="900" style="width:100%;border-radius:28px;box-shadow:var(--shadow)">
      {%- endif -%}
      <div>
        <h1 style="font-size:clamp(2rem,6vw,3rem)">{{ product.title }}</h1>
        <p style="font-size:1.5rem;font-weight:700;margin:10px 0 18px;color:var(--berry)">
          {{ product.price | money }}
          {%- if product.compare_at_price > product.price %} <s style="color:var(--muted);font-weight:500;font-size:1.05rem">{{ product.compare_at_price | money }}</s>{% endif -%}
        </p>
        {%- form 'product', product -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="btn btn-berry btn-xl jelly">Add to cart</button>
        {%- endform -%}
        <div class="rte" style="margin-top:24px">{{ product.description }}</div>
      </div>
    </div>
  </div>
{%- endif -%}
{% schema %}
{ "name": "glassé product", "settings": [] }
{% endschema %}
