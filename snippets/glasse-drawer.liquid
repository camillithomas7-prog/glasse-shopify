<!-- SECTION: cart-drawer (local simulation, no real checkout) -->
<div class="drawer-scrim" data-cart-scrim hidden></div>
<aside class="drawer" data-drawer role="dialog" aria-modal="true" aria-labelledby="cart-title" hidden>
  <div class="drawer-grip" aria-hidden="true"></div>
  <div class="drawer-head">
    <h2 id="cart-title">your cart <span class="count-pill" data-cart-count-pill>0</span></h2>
    <button type="button" class="icon-btn" data-cart-close aria-label="Close cart"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
  </div>

  <div class="drawer-view" data-view="cart">
    <div class="drawer-ship">
      <p class="ship-msg" data-cart-ship-msg aria-live="polite"></p>
      <div class="ship-track ship-track-lg" aria-hidden="true"><span data-cart-ship-fill></span><i class="ship-goal"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="7" cy="17" r="1.6" fill="currentColor"/><circle cx="17" cy="17" r="1.6" fill="currentColor"/></svg></i></div>
    </div>

    <div class="drawer-body" data-drawer-body>
      <ul class="cart-lines" data-cart-lines aria-live="polite"></ul>

      <div class="cart-empty" data-cart-empty>
        <img src="{{ 'jar-800.webp' | asset_url }}" alt="" width="120" height="149" loading="lazy">
        <p>nothing here yet. your skin is waiting.</p>
        <button type="button" class="btn btn-berry jelly" data-empty-add>Add the duo</button>
      </div>

      <div class="upgrade" data-upgrade hidden></div>

      <section class="addons" data-addons aria-labelledby="addons-title" hidden>
        <h3 id="addons-title">complete the routine</h3>
        <div class="addon-card">
          <img src="{{ 'spot-dots-400.webp' | asset_url }}" alt="glassé spot dots: droplet-shaped hydrocolloid patches in a chrome tin" width="400" height="400" loading="lazy">
          <div class="addon-info">
            <span class="addon-tag">new · for the "oh no" days</span>
            <b>glassé spot dots</b>
            <span class="addon-meta">36 droplet-shaped hydrocolloid patches. pad for the glow, dot for the spot.</span>
          </div>
          <div class="addon-buy">
            <b>$9</b>
            <button type="button" class="btn-add jelly" data-add-item="dots" aria-label="Add glassé spot dots for $9">+ add</button>
          </div>
        </div>
      </section>

      <ul class="perks" data-perks hidden>
        <li><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 3l6 12M19 3l-6 12M11 15l-1 6M13 15l1 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>chrome tongs in every jar</li>
        <li><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z" fill="none" stroke="currentColor" stroke-width="2"/></svg>30-day money-back guarantee</li>
        <li><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>ships in 5–7 business days</li>
      </ul>
    </div>

    <div class="drawer-foot" data-drawer-foot hidden>
      <div class="cart-row cart-save" data-cart-save-row hidden><span>you're saving</span><b data-cart-save></b></div>
      <div class="cart-row"><span>Subtotal</span><span data-cart-subtotal>$0.00</span></div>
      <div class="cart-row"><span>Shipping</span><span data-cart-shipping></span></div>
      <div class="cart-row cart-total"><span>Total</span><b data-cart-total>$0.00</b></div>
      <button type="button" class="btn btn-berry btn-xl jelly" data-checkout>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        <span>Checkout</span><span class="btn-sep" aria-hidden="true">·</span><span data-checkout-total>$0</span>
      </button>
      <p class="pay-row" aria-label="Accepted payments">
        <span class="pay">Apple Pay</span><span class="pay">G Pay</span><span class="pay">Shop Pay</span><span class="pay">Visa</span><span class="pay">PayPal</span>
      </p>
    </div>
  </div>

  <!-- Post-purchase one-click offer (demo) -->
  <div class="drawer-view pp" data-view="offer" hidden>
    <div class="pp-body">
      <p class="pp-kicker">wait, one-time offer</p>
      <h3>Add 1 more jar for <span class="pp-price">$18</span> <s>$24</s></h3>
      <img src="{{ 'jar-800.webp' | asset_url }}" alt="glassé Salmon DNA Jelly Pads jar" width="400" height="496" loading="lazy">
      <p class="pp-text">25% off, only on this screen. Same order, same shipping, one tap. Future you, three weeks from now, says thanks.</p>
    </div>
    <div class="pp-foot">
      <button type="button" class="btn btn-berry btn-xl jelly" data-pp-yes>Yes, add it · $18</button>
      <button type="button" class="btn pp-no" data-pp-no>No thanks, complete my order</button>
    </div>
  </div>
</aside>

