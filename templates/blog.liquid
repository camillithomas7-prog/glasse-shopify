<div class="wrap dp-page"><h1>{{ blog.title }}</h1>
{%- for article in blog.articles -%}
  <article style="border-bottom:1px solid var(--line);padding:18px 0">
    <a href="{{ article.url }}" style="font-weight:700;font-size:19px;text-decoration:none">{{ article.title }}</a>
    <p style="color:var(--muted);margin:8px 0 0">{{ article.excerpt_or_content | strip_html | truncate: 180 }}</p>
  </article>
{%- endfor -%}
</div>
