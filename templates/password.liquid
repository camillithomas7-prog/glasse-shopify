<img src="{{ 'logo.webp' | asset_url }}" alt="{{ shop.name }}" width="180" height="70" style="margin:0 auto 18px">
<p style="color:var(--muted)">the salmon DNA pad is almost here.</p>
{% form 'storefront_password' %}
  {{ form.errors | default_errors }}
  <input type="password" name="password" placeholder="Password" style="padding:13px 18px;border:1.5px solid rgba(59,18,32,.2);border-radius:999px;font:inherit">
  <button class="dp-btn dp-btn--brand" type="submit">Enter</button>
{% endform %}
